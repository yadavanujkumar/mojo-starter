"""
Example 01: Hello World
=======================
Your first Mojo program! This demonstrates:
- The main() function (entry point)
- Printing output to console
- Basic Mojo syntax

To run: mojo run examples/01_hello_world.mojo
"""


fn main():
    """
    The main function is the entry point of every Mojo program.
    It's similar to Python's if __name__ == "__main__"
    """
    print("🔥 Hello, Mojo!")
    print("Welcome to the world of high-performance programming!")
    
    # You can also use multi-line strings
    print("""
    Mojo combines:
    - Python's simplicity
    - C's performance
    - Modern language features
    """)
